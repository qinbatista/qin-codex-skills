{
  "schema_version": 1,
  "catalog_id": "qin-global-skill-retained-capabilities",
  "policy": {
    "all_retained_capabilities_are_non_regression_requirements": true,
    "local_deployment_requires_pass": true,
    "github_publication_requires_pass": true,
    "retirement_requires_explicit_user_decision": true,
    "process_contract_is_not_result_memory": true
  },
  "managed_skills": [
    "task-analyze-skill",
    "workflow-skill",
    "prompt-skill",
    "code-skill",
    "project-memory-skill",
    "verify-skill",
    "optimization-skill",
    "management-skill"
  ],
  "checks": [
    {"id": "public-skill-set", "kind": "builtin", "targets": ["source", "deployed"], "timeout_seconds": 30},
    {"id": "task-analyze-units", "kind": "command", "targets": ["source", "deployed"], "timeout_seconds": 1200, "command": ["{python}", "-m", "unittest", "discover", "-s", "task-analyze-skill/tests", "-p", "test_*.py"]},
    {"id": "prompt-units", "kind": "command", "targets": ["source", "deployed"], "timeout_seconds": 300, "command": ["{python}", "-m", "unittest", "discover", "-s", "prompt-skill/tests", "-p", "test_*.py"]},
    {"id": "code-units", "kind": "command", "targets": ["source", "deployed"], "timeout_seconds": 600, "command": ["{python}", "-m", "unittest", "discover", "-s", "code-skill/tests", "-p", "test_*.py"]},
    {"id": "project-memory-units", "kind": "command", "targets": ["source", "deployed"], "timeout_seconds": 600, "command": ["{python}", "-m", "unittest", "discover", "-s", "project-memory-skill/tests", "-p", "test_*.py"]},
    {"id": "verify-units", "kind": "command", "targets": ["source", "deployed"], "timeout_seconds": 300, "command": ["{python}", "-m", "unittest", "discover", "-s", "verify-skill/tests", "-p", "test_*.py"]},
    {"id": "optimization-units", "kind": "command", "targets": ["source", "deployed"], "timeout_seconds": 300, "command": ["{python}", "-m", "unittest", "discover", "-s", "optimization-skill/tests", "-p", "test_*.py"]},
    {"id": "management-units", "kind": "command", "targets": ["source", "deployed"], "timeout_seconds": 900, "command": ["{python}", "-m", "unittest", "discover", "-s", "management-skill/tests", "-p", "test_*.py"]},
    {"id": "task-analyze-validator", "kind": "command", "targets": ["source", "deployed"], "timeout_seconds": 300, "command": ["{python}", "task-analyze-skill/scripts/validate_task_analyze_skill.py", "--skill-dir", "task-analyze-skill", "--global-agents", "{global_agents}", "--global-skills-root", "."]},
    {"id": "workflow-validator", "kind": "command", "targets": ["source", "deployed"], "timeout_seconds": 300, "command": ["{python}", "workflow-skill/scripts/validate_workflow_skill.py"]},
    {"id": "model-capability-sync", "kind": "command", "targets": ["source", "deployed"], "timeout_seconds": 300, "command": ["{python}", "task-analyze-skill/scripts/sync_model_capabilities.py", "--check"]},
    {"id": "platform-check", "kind": "command", "targets": ["source", "deployed"], "timeout_seconds": 300, "command": ["{python}", "code-skill/scripts/skill_platform_check.py", "check", "--skills-root", ".", "--baseline", "code-skill/assets/skill-platform-baseline.json"]},
    {"id": "optimization-audit", "kind": "command", "targets": ["source", "deployed"], "timeout_seconds": 300, "command": ["{python}", "optimization-skill/scripts/audit_global_skills.py", "."]},
    {"id": "code-sample-attestation", "kind": "attestation", "targets": ["source"], "timeout_seconds": 30, "path": "management-skill/assets/regression-attestations/code-writing-samples.json", "evidence": "Cache/tests/code-writing-philosophy/review/forward-test-report.json", "watched_files": ["code-skill/SKILL.md", "code-skill/agents/openai.yaml", "code-skill/references/code-writing-philosophy.md", "code-skill/references/coding-approach.md", "code-skill/tests/test_code_writing_philosophy.py"]},
    {"id": "unity-five-attestation", "kind": "attestation", "targets": ["source"], "timeout_seconds": 30, "path": "management-skill/assets/regression-attestations/unity-five-trials.json", "evidence": "Cache/tests/unity-game-code-structure-design/result.json", "watched_files": ["code-skill/SKILL.md", "code-skill/agents/openai.yaml", "code-skill/references/unity-csharp-rules.md", "code-skill/references/unity-game-code-structure-design.md", "code-skill/tests/test_code_writing_philosophy.py"]},
    {"id": "memory-execution-consistency-attestation", "kind": "attestation", "targets": ["source"], "timeout_seconds": 30, "path": "management-skill/assets/regression-attestations/memory-execution-consistency.json", "evidence": "Cache/tests/memory-execution-consistency/result.json", "bind_evidence": true, "watched_files": ["AGENTS.md", "task-analyze-skill/assets/global-agents-entry-rule.md", "task-analyze-skill/scripts/task_route_dispatcher.py", "task-analyze-skill/scripts/validate_task_analyze_skill.py", "workflow-skill/SKILL.md", "code-skill/references/python-rules.md", "project-memory-skill/SKILL.md", "project-memory-skill/scripts/project_change_memory.py", "project-memory-skill/scripts/memory_coverage.py", "project-memory-skill/scripts/obsidian_model_memory.py", "project-memory-skill/tests/test_project_change_memory.py", "project-memory-skill/tests/test_memory_coverage.py", "project-memory-skill/tests/test_obsidian_model_memory.py", "verify-skill/SKILL.md", "verify-skill/scripts/ending_verification_plan.py", "verify-skill/scripts/ending_task_ledger.py", "management-skill/assets/global-skill-capability-catalog.json", "management-skill/scripts/global_skill_regression_gate.py", "management-skill/tests/test_global_skill_regression_gate.py"]},
    {"id": "git-diff-check", "kind": "command", "targets": ["source"], "timeout_seconds": 60, "command": ["git", "diff", "--check"]},
    {"id": "deployment-parity", "kind": "builtin", "targets": ["cross"], "timeout_seconds": 120},
    {"id": "global-agents-parity", "kind": "builtin", "targets": ["cross"], "timeout_seconds": 30}
  ],
  "capabilities": [
    {"id": "GSR-001", "owner_skill": "management-skill", "name": "固定八个公共 Skill", "function": "公共源码与远端只包含八个批准的 Skill，同时保留本地无关 Skill。", "checks": ["public-skill-set", "management-units", "optimization-audit", "deployment-parity"]},
    {"id": "GSR-002", "owner_skill": "management-skill", "name": "源码、部署与发布分离", "function": "仓库源码是维护权威；本地全局部署与 GitHub 发布是两个独立动作，禁止从安装镜像反向覆盖源码。", "checks": ["management-units", "deployment-parity"]},
    {"id": "GSR-003", "owner_skill": "management-skill", "name": "双全局 AGENTS 入口", "function": "部署同时更新 Codex 根与主机可发现的用户级 AGENTS，任一漂移都失败。", "checks": ["management-units", "global-agents-parity"]},
    {"id": "GSR-004", "owner_skill": "task-analyze-skill", "name": "0-100 复杂度评分", "function": "每次提交使用 small、standard、complex、advanced 四个固定分段。", "checks": ["task-analyze-units", "task-analyze-validator"]},
    {"id": "GSR-005", "owner_skill": "task-analyze-skill", "name": "入口模型与解决模型分离", "function": "先保留 entry，再按难度、信息负担、步骤和历史选择 solver；允许 Sol 降级与 Luna 升级。", "checks": ["task-analyze-units", "task-analyze-validator", "model-capability-sync"]},
    {"id": "GSR-006", "owner_skill": "task-analyze-skill", "name": "Spark 小任务与质量升降档", "function": "低风险小任务优先 Spark；质量失败抑制同指纹并升级；两个 Real PASS 后才试降一级。", "checks": ["task-analyze-units", "model-capability-sync"]},
    {"id": "GSR-007", "owner_skill": "task-analyze-skill", "name": "多阶段独立路由", "function": "实现、测试和部署阶段独立选模；Ending 分数只控制检查范围；只并行依赖就绪且无共享写入的节点。", "checks": ["task-analyze-units", "workflow-validator"]},
    {"id": "GSR-008", "owner_skill": "task-analyze-skill", "name": "准确模型身份披露", "function": "结果公开 Complexity、Model、Route、Evidence；多阶段列出全部实际阶段且 receipt 优先。", "checks": ["task-analyze-units", "task-analyze-validator"]},
    {"id": "GSR-009", "owner_skill": "task-analyze-skill", "name": "模型路由记忆", "function": "本地 receipt ledger 为快速权威，Obsidian 使用原生链接并保留项目、任务、模块、文件和 symbol 范围。", "checks": ["task-analyze-units", "project-memory-units"]},
    {"id": "GSR-010", "owner_skill": "project-memory-skill", "name": "每次提交的个人记忆候选", "function": "每次用户提交做有界候选扫描；无候选不写；只保存脱敏持久偏好。", "checks": ["project-memory-units", "verify-units"]},
    {"id": "GSR-011", "owner_skill": "project-memory-skill", "name": "项目模块方法记忆覆盖", "function": "修改前按项目、模块、文件和 symbol 回溯；方法级代码必须有 symbol，模块级用 __module__，Ending PASS 后才记结果。", "checks": ["project-memory-units", "verify-units"]},
    {"id": "GSR-012", "owner_skill": "workflow-skill", "name": "主结果优先", "function": "主任务只完成生产结果和 bounded Quick Check，立即返回，不等待或轮询 Ending。", "checks": ["task-analyze-units", "workflow-validator"]},
    {"id": "GSR-013", "owner_skill": "workflow-skill", "name": "每个新任务 100% Ending", "function": "任何新任务都启动 Ending；简单读取只缩小检查，不能跳过。", "checks": ["task-analyze-units", "workflow-validator", "verify-units"]},
    {"id": "GSR-014", "owner_skill": "verify-skill", "name": "独立 projectless Ending", "function": "每个新任务只创建一个持久 projectless End Task；计划内保留独立检查，携带原项目 binding，真实创建并 100% ack。", "checks": ["verify-units", "workflow-validator"]},
    {"id": "GSR-015", "owner_skill": "verify-skill", "name": "Ending 最小真实验证", "function": "执行能证明交付状态的最小真实命令、API、构建、渲染、视觉或状态检查；文字不能代替证据，当前不可变 PASS 报告只复查绑定 digest 与最终状态。", "checks": ["verify-units", "workflow-validator"]},
    {"id": "GSR-016", "owner_skill": "verify-skill", "name": "失败返回原 session 修复", "function": "Verifier 不改生产文件；精确证据返回 immutable origin；原 session 修复后把合法 failed-parent lifecycle ID 从 plan 或 create-launches 贯穿到 launch spec 和 worker，并强制 fresh Ending 用同一 --repair-of-lifecycle-id 启动；最多三次，否则 BLOCKED。", "checks": ["verify-units", "project-memory-units", "workflow-validator"]},
    {"id": "GSR-017", "owner_skill": "verify-skill", "name": "Ending 终态永久可见", "function": "PASS、FAIL、BLOCKED 不自动归档或删除，并报告尝试、适配度、下一路线与记忆状态。", "checks": ["verify-units", "workflow-validator"]},
    {"id": "GSR-018", "owner_skill": "prompt-skill", "name": "Prompt Skill 100% 入口", "function": "可复用 prompt 与持久 AI 指令的创建、修改、测试必须加载 Prompt；普通文案不误触发。", "checks": ["prompt-units", "task-analyze-units", "task-analyze-validator"]},
    {"id": "GSR-019", "owner_skill": "code-skill", "name": "所有语言的代码书写哲学", "function": "先读项目结构和 AGENTS，写最少 coherent change，保持清晰 ownership，并检查内存、磁盘、CPU、资源和长期生命周期；过程与结果记忆分离。", "checks": ["code-units", "task-analyze-units", "code-sample-attestation", "platform-check"]},
    {"id": "GSR-020", "owner_skill": "code-skill", "name": "Unity 游戏全局结构设计", "function": "所有 Unity 游戏 C# 强制使用 Controller、Manager、ScriptableObject 核心和有触发条件的模式；项目只能加强，不能削弱。", "checks": ["code-units", "task-analyze-units", "unity-five-attestation", "platform-check"]},
    {"id": "GSR-021", "owner_skill": "code-skill", "name": "跨平台执行", "function": "Host/Skill 工具使用 portable Python 和 native path，覆盖 Windows、macOS、Linux，同时保留 Unity/Docker 运行时边界。", "checks": ["code-units", "optimization-units", "management-units", "platform-check"]},
    {"id": "GSR-022", "owner_skill": "management-skill", "name": "Cache 与结构化 AGENTS", "function": "支持产物只进项目 Cache；机器路径只进 AI-only registry；项目 AGENTS 只保留稳定结构、owner、入口和硬约束。", "checks": ["management-units", "code-units", "platform-check"]},
    {"id": "GSR-023", "owner_skill": "management-skill", "name": "公开 README、SVG 与 benchmark 证据", "function": "中英文模板和桌面/移动 SVG 可解析且无裁切；benchmark 只声明来源明确的稳定结果并分离 controller、retry 与 Ending。", "checks": ["management-units", "task-analyze-units"]},
    {"id": "GSR-024", "owner_skill": "optimization-skill", "name": "Optimization 有界触发", "function": "只在明确优化或稳定重复工作时触发，把已验证流程固化为 portable 资产且保持行为。", "checks": ["optimization-units", "optimization-audit", "platform-check"]},
    {"id": "GSR-025", "owner_skill": "management-skill", "name": "全能力非回归发布门禁", "function": "任何全局 Skill 新增或修改都重跑保留能力目录；本地部署和 GitHub commit/push 在门禁 PASS 前全部阻断。", "checks": ["management-units", "public-skill-set", "deployment-parity", "global-agents-parity", "git-diff-check"]},
    {"id": "GSR-026", "owner_skill": "verify-skill", "name": "Spark-xhigh 快速 Ending", "function": "所有 Ending 固定首选 gpt-5.3-codex-spark|xhigh；分数只控制检查范围。只有明确模型、effort、调度或必需模态不可用时才回退 registry-floor Luna-low；质量、协议、执行、超时或验收失败只修 producer，不升级 verifier。", "checks": ["task-analyze-units", "verify-units", "project-memory-units", "workflow-validator", "management-units"]},
    {"id": "GSR-027", "owner_skill": "project-memory-skill", "name": "过程、执行与有效结果记忆一致", "function": "当前过程 Skill/AGENTS、真实执行证据和 effective 项目结果记忆必须三方一致。Ending 只可为纯记忆缺陷追加纠正或重投影；Skill/执行缺陷不得写结果记忆，必须返回 immutable origin 修复；下一任务只读取 effective 结果并隐藏已 supersede 的记录。", "checks": ["memory-execution-consistency-attestation", "task-analyze-units", "task-analyze-validator", "workflow-validator", "project-memory-units", "verify-units"]},
    {"id": "GSR-028", "owner_skill": "project-memory-skill", "name": "项目结果记忆完整性防线", "function": "生产 recorder 在写入前拒绝占位语义；测试显式使用 disposable store/vault；Global Codex Skills 与 qin-codex-skills 统一 owner 回读；已证实的非法记录只可用 exact-ID tombstone 重建本地索引并阻断 reconcile 回灌。", "checks": ["project-memory-units", "memory-execution-consistency-attestation", "platform-check"]},
    {"id": "GSR-029", "owner_skill": "project-memory-skill", "name": "唯一 Coverage 权威与无截断投影", "function": "Coverage 只读取显式 CODEX_PROJECT_MEMORY_COVERAGE 或 canonical local store，绝不从 vault/model store 推导；append、merge、projection 共用事务锁；legacy rogue store 仅在验证合并和重投影后按 exact path 删除。", "checks": ["project-memory-units", "memory-execution-consistency-attestation", "platform-check"]}
  ],
