{
  "schema_version": 1,
  "catalog_id": "qin-global-skill-retained-capabilities",
  "policy": {
    "all_retained_capabilities_are_non_regression_requirements": true,
    "local_deployment_completion_requires_pass": false,
    "local_install_write_requires_pass": false,
    "local_install_semantic_precheck_allowed": false,
    "local_install_always_replaces_managed_skills": true,
    "local_install_preserves_user_global_agents": true,
    "local_install_backup_and_safe_write_prerequisites_only": true,
    "local_installation_completion_requires_pass": false,
    "consumer_install_runs_semantic_validation": false,
    "agent_owns_install_test_repair": false,
    "maintainer_publication_owns_release_validation": true,
    "github_publication_requires_pass": true,
    "retirement_requires_explicit_user_decision": true,
    "process_contract_is_not_result_memory": true,
    "workflow_version": 2,
    "verification_owner": "active_task",
    "ending_purpose": "memory_only",
    "selected_model_for_governed_tasks": true,
    "missing_memory": "skip",
    "task_score_disclosure": "required",
    "model_disclosure": "assignment_then_runtime",
    "ending_placement": "visible_projectless_under_user_authorized_lifecycle",
    "ending_completion": "task_acknowledgement_and_scoped_memory_readback"
  },
  "managed_skills": [
    "task-analyze-skill",
    "workflow-skill",
    "prompt-skill",
    "code-skill",
    "project-memory-skill",
    "verify-skill",
    "optimization-skill",
    "management-skill"
  ],
  "checks": [
    {
      "id": "public-skill-set",
      "kind": "builtin",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 30
    },
    {
      "id": "task-analyze-units",
      "kind": "command",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 1200,
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "task-analyze-skill/tests",
        "-p",
        "test_*.py"
      ]
    },
    {
      "id": "prompt-units",
      "kind": "command",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 300,
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "prompt-skill/tests",
        "-p",
        "test_*.py"
      ]
    },
    {
      "id": "code-units",
      "kind": "command",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 600,
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "code-skill/tests",
        "-p",
        "test_*.py"
      ]
    },
    {
      "id": "project-memory-units",
      "kind": "command",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 600,
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "project-memory-skill/tests",
        "-p",
        "test_*.py"
      ]
    },
    {
      "id": "verify-units",
      "kind": "command",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 300,
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "verify-skill/tests",
        "-p",
        "test_*.py"
      ]
    },
    {
      "id": "optimization-units",
      "kind": "command",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 300,
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "optimization-skill/tests",
        "-p",
        "test_*.py"
      ]
    },
    {
      "id": "management-units",
      "kind": "command",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 900,
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "management-skill/tests",
        "-p",
        "test_*.py"
      ]
    },
    {
      "id": "task-analyze-validator",
      "kind": "command",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 300,
      "command": [
        "{python}",
        "task-analyze-skill/scripts/validate_task_analyze_skill.py",
        "--skill-dir",
        "task-analyze-skill",
        "--global-agents",
        "{global_agents}",
        "--global-skills-root",
        "."
      ]
    },
    {
      "id": "workflow-validator",
      "kind": "command",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 300,
      "command": [
        "{python}",
        "workflow-skill/scripts/validate_workflow_skill.py"
      ]
    },
    {
      "id": "workflow-units",
      "kind": "command",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 300,
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "workflow-skill/tests",
        "-p",
        "test_*.py"
      ]
    },
    {
      "id": "platform-check",
      "kind": "command",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 300,
      "command": [
        "{python}",
        "code-skill/scripts/skill_platform_check.py",
        "check",
        "--skills-root",
        ".",
        "--baseline",
        "code-skill/assets/skill-platform-baseline.json"
      ]
    },
    {
      "id": "optimization-audit",
      "kind": "command",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 300,
      "command": [
        "{python}",
        "optimization-skill/scripts/audit_global_skills.py",
        "."
      ]
    },
    {
      "id": "cache-layout-units",
      "kind": "command",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 300,
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "management-skill/tests",
        "-p",
        "test_cache_layout.py"
      ]
    },
    {
      "id": "git-diff-check",
      "kind": "command",
      "targets": [
        "source"
      ],
      "timeout_seconds": 60,
      "command": [
        "git",
        "diff",
        "--check"
      ]
    },
    {
      "id": "deployment-parity",
      "kind": "builtin",
      "targets": [
        "cross"
      ],
      "timeout_seconds": 120
    },
    {
      "id": "global-agents-parity",
      "kind": "builtin",
      "targets": [
        "cross"
      ],
      "timeout_seconds": 30
    }
  ],
  "capabilities": [
    {
      "id": "selected-model",
      "owner_skill": "task-analyze-skill",
      "name": "Selected-model ownership",
      "function": "Skill-governed work and memory preserve the user-selected model and effort; only independent unconstrained work routes adaptively.",
      "checks": [
        "task-analyze-units",
        "project-memory-units"
      ]
    },
    {
      "id": "adaptive-routing",
      "owner_skill": "task-analyze-skill",
      "name": "Independent adaptive work",
      "function": "Complexity and verified history choose suitable models only for skill-independent tasks; mechanical tools need no model.",
      "checks": [
        "task-analyze-units"
      ]
    },
    {
      "id": "coordination",
      "owner_skill": "workflow-skill",
      "name": "Clear goals and safe parallel work",
      "function": "Use bounded goals, dependencies, disjoint writes and root-owned completion; avoid mandatory decomposition of simple work.",
      "checks": [
        "workflow-units",
        "workflow-validator",
        "task-analyze-units"
      ]
    },
    {
      "id": "verification",
      "owner_skill": "verify-skill",
      "name": "Verification inside the task",
      "function": "Use focused real evidence for consequential changes, skip simple values, and require user scope for whole-project runs.",
      "checks": [
        "verify-units",
        "workflow-validator"
      ]
    },
    {
      "id": "ending-memory",
      "owner_skill": "project-memory-skill",
      "name": "Memory-only Ending",
      "function": "Summarize durable facts using the selected model; never launch verification, automatic repair, or compulsory detached tasks.",
      "checks": [
        "project-memory-units",
        "verify-units"
      ]
    },
    {
      "id": "project-isolation",
      "owner_skill": "project-memory-skill",
      "name": "Optional scoped recall",
      "function": "Read only matching project memory and explicitly relevant shared preferences; skip absent memory; cross-project reads require an explicit audit.",
      "checks": [
        "project-memory-units",
        "task-analyze-units"
      ]
    },
    {
      "id": "concise-code",
      "owner_skill": "code-skill",
      "name": "Reusable code and visual presentation preferences",
      "function": "Preserve explicit code ownership and readable structure; every UI, PDF report, document and slide layout applies the shared readable UI baseline, including work without code changes.",
      "checks": [
        "code-units",
        "prompt-units",
        "workflow-units",
        "verify-units"
      ]
    },
    {
      "id": "privacy",
      "owner_skill": "project-memory-skill",
      "name": "Durable concise facts",
      "function": "Keep effective current outcomes and useful history without raw prompts, secrets, or project mixing; read back writes.",
      "checks": [
        "project-memory-units"
      ]
    },
    {
      "id": "installation",
      "owner_skill": "management-skill",
      "name": "Recoverable managed installation",
      "function": "Lock, backup, replace exact managed sources, recover after interruption, preserve unrelated skills and private local history.",
      "checks": [
        "management-units"
      ]
    },
    {
      "id": "agents-preservation",
      "owner_skill": "management-skill",
      "name": "Global AGENTS preservation",
      "function": "Normal installation preserves user AGENTS; explicit AGENTS installation creates a persistent restorable backup.",
      "checks": [
        "management-units",
        "global-agents-parity"
      ]
    },
    {
      "id": "source-publication",
      "owner_skill": "management-skill",
      "name": "Source, installation and publication",
      "function": "Source owns maintained behavior; local installation and authorized remote publication remain separate; publication runs current release checks first.",
      "checks": [
        "management-units",
        "public-skill-set",
        "deployment-parity",
        "git-diff-check"
      ]
    },
    {
      "id": "portability",
      "owner_skill": "code-skill",
      "name": "Portable host execution",
      "function": "Host helpers use portable Python, native paths and noninteractive execution without forcing whole project builds.",
      "checks": [
        "code-units",
        "platform-check"
      ]
    },
    {
      "id": "optimization",
      "owner_skill": "optimization-skill",
      "name": "Measured simplification",
      "function": "Optimize requested or recurring work with measured evidence; do not invent model savings or trigger routine benchmarks.",
      "checks": [
        "optimization-units",
        "optimization-audit"
      ]
    },
    {
      "id": "resources",
      "owner_skill": "workflow-skill",
      "name": "Scoped resource ownership",
      "function": "Dispose only task-owned scratch after last-consumer readback; preserve shared resources and other tasks.",
      "checks": [
        "workflow-units",
        "cache-layout-units"
      ]
    },
    {
      "id": "concise-contracts",
      "owner_skill": "management-skill",
      "name": "Concise current instructions",
      "function": "Entries and references describe current responsibilities without repeated lifecycle ceremonies; behavioral tests replace obsolete workflow text checks.",
      "checks": [
        "task-analyze-validator",
        "workflow-validator",
        "management-units"
      ]
    }
  ],
  "retired_architectures": [
    {
      "id": "legacy-detached-verification",
      "name": "Fixed Spark Ending verification and automatic repair tasks",
      "replacement": "ending-memory"
    },
    {
      "id": "legacy-universal-routing",
      "name": "Mandatory adaptive delegation and repeated Code Gate ceremonies for skill-governed work",
      "replacement": "selected-model"
    },
    {
      "id": "legacy-benchmark-attestations",
      "name": "Old workflow benchmark and text attestation evidence as current release requirements",
      "replacement": "concise-contracts"
    }
  ]
}
