{
  "schema_version": 1,
  "catalog_id": "qin-global-skill-retained-capabilities",
  "policy": {
    "all_retained_capabilities_are_non_regression_requirements": true,
    "local_deployment_completion_requires_pass": false,
    "local_install_write_requires_pass": false,
    "local_install_semantic_precheck_allowed": false,
    "local_install_always_replaces_managed_skills": true,
    "local_install_preserves_user_global_agents": true,
    "local_install_backup_and_safe_write_prerequisites_only": true,
    "local_installation_completion_requires_pass": false,
    "consumer_install_runs_semantic_validation": false,
    "agent_owns_install_test_repair": false,
    "maintainer_publication_owns_release_validation": true,
    "github_publication_requires_pass": true,
    "retirement_requires_explicit_user_decision": true,
    "process_contract_is_not_result_memory": true,
    "workflow_version": 4,
    "verification_owner": "active_task",
    "ending_purpose": "memory_and_resources",
    "missing_memory": "bootstrap_vault_then_skip_absent_matching_note",
    "ending_placement": "visible_unpinned_projectless_recent_task",
    "ending_independent_of_main_result": true,
    "ending_completion": "task_acknowledgement_and_independent_memory_resource_readbacks",
    "execution_preview": "brief_goal_and_steps_before_execution",
    "action_request_completion": "execute_recover_deliver_or_evidenced_blocker",
    "skill_usage_reporting": "final_only_actual_use_steps_and_reasons"
  },
  "managed_skills": [
    "task-analyze-skill",
    "workflow-skill",
    "prompt-skill",
    "code-skill",
    "project-memory-skill",
    "verify-skill",
    "optimization-skill",
    "management-skill"
  ],
  "checks": [
    {
      "id": "public-skill-set",
      "kind": "builtin",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 30
    },
    {
      "id": "project-testing-units",
      "kind": "command",
      "targets": [
        "source"
      ],
      "timeout_seconds": 120,
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        ".agents/skills/testing-skill/tests",
        "-p",
        "test_*.py"
      ]
    },
    {
      "id": "prompt-units",
      "kind": "command",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 300,
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "prompt-skill/tests",
        "-p",
        "test_*.py"
      ]
    },
    {
      "id": "code-units",
      "kind": "command",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 600,
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "code-skill/tests",
        "-p",
        "test_*.py"
      ]
    },
    {
      "id": "project-memory-units",
      "kind": "command",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 600,
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "project-memory-skill/tests",
        "-p",
        "test_*.py"
      ]
    },
    {
      "id": "verify-units",
      "kind": "command",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 300,
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "verify-skill/tests",
        "-p",
        "test_*.py"
      ]
    },
    {
      "id": "optimization-units",
      "kind": "command",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 300,
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "optimization-skill/tests",
        "-p",
        "test_*.py"
      ]
    },
    {
      "id": "management-units",
      "kind": "command",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 900,
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "management-skill/tests",
        "-p",
        "test_*.py"
      ]
    },
    {
      "id": "workflow-validator",
      "kind": "command",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 300,
      "command": [
        "{python}",
        "workflow-skill/scripts/validate_workflow_skill.py"
      ]
    },
    {
      "id": "workflow-units",
      "kind": "command",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 300,
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "workflow-skill/tests",
        "-p",
        "test_*.py"
      ]
    },
    {
      "id": "platform-check",
      "kind": "command",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 300,
      "command": [
        "{python}",
        "code-skill/scripts/skill_platform_check.py",
        "check",
        "--skills-root",
        ".",
        "--baseline",
        "code-skill/assets/skill-platform-baseline.json"
      ]
    },
    {
      "id": "optimization-audit",
      "kind": "command",
      "targets": [
        "source",
        "deployed"
      ],
      "timeout_seconds": 300,
      "command": [
        "{python}",
        "optimization-skill/scripts/audit_global_skills.py",
        "."
      ]
    },
    {
      "id": "git-diff-check",
      "kind": "command",
      "targets": [
        "source"
      ],
      "timeout_seconds": 60,
      "command": [
        "git",
        "diff",
        "--check"
      ]
    },
    {
      "id": "deployment-parity",
      "kind": "builtin",
      "targets": [
        "cross"
      ],
      "timeout_seconds": 120
    },
    {
      "id": "global-agents-parity",
      "kind": "builtin",
      "targets": [
        "cross"
      ],
      "timeout_seconds": 30
    }
  ],
  "capabilities": [
    {
      "id": "skill-usage-visibility",
      "owner_skill": "task-analyze-skill",
      "name": "Final Skill use summary",
      "function": "Record each actually used Skill's exact name, applied step or action, and reason during the task, including delegated use; report one truthful summary in the final response without repeating Skill lists at startup or in progress updates.",
      "checks": [
        "prompt-units",
        "management-units",
        "global-agents-parity"
      ]
    },
    {
      "id": "action-completion",
      "owner_skill": "task-analyze-skill",
      "name": "Action delivery and failure recovery",
      "function": "Carry action requests through implementation and recovery; report delivered changes separately from verification, and stop affected work only for evidenced blockers after useful authorized routes are exhausted.",
      "checks": [
        "prompt-units"
      ]
    },
    {
      "id": "coordination",
      "owner_skill": "workflow-skill",
      "name": "Clear goals and safe parallel work",
      "function": "Briefly explain goals and implementation steps before execution; keep dependencies ordered and integrate results in the active task.",
      "checks": [
        "workflow-units",
        "workflow-validator"
      ]
    },
    {
      "id": "verification",
      "owner_skill": "verify-skill",
      "name": "Verification inside the task",
      "function": "Use focused real behavior evidence or output readback for changed code and consequential results; require user scope for whole-project runs.",
      "checks": [
        "verify-units",
        "workflow-validator",
        "project-testing-units"
      ]
    },
    {
      "id": "ending-memory",
      "owner_skill": "project-memory-skill",
      "name": "Ending memory branch",
      "function": "Consolidate scoped central Obsidian knowledge and due synthesis independently of parallel resource cleanup.",
      "checks": [
        "project-memory-units",
        "verify-units"
      ]
    },
    {
      "id": "project-isolation",
      "owner_skill": "project-memory-skill",
      "name": "Optional scoped recall",
      "function": "Recall exact project/module/file/symbol entries from a centralized index; exclude stale method facts and expose cross-project links only as separate references.",
      "checks": [
        "project-memory-units"
      ]
    },
    {
      "id": "concise-code",
      "owner_skill": "code-skill",
      "name": "Reusable code and visual presentation preferences",
      "function": "Preserve explicit code ownership and readable structure; every UI, PDF report, document and slide layout applies the shared readable UI baseline, including work without code changes.",
      "checks": [
        "code-units",
        "prompt-units",
        "workflow-units",
        "verify-units"
      ]
    },
    {
      "id": "privacy",
      "owner_skill": "project-memory-skill",
      "name": "Durable concise facts",
      "function": "Keep effective current outcomes and useful history without raw prompts, secrets, or project mixing; read back writes.",
      "checks": [
        "project-memory-units"
      ]
    },
    {
      "id": "installation",
      "owner_skill": "management-skill",
      "name": "Recoverable managed installation",
      "function": "Install into the official user root with locking, backup and recovery; automatically consolidate verified legacy copies, preserve project scope and private data, and report conflicts or permissions as pending.",
      "checks": [
        "management-units"
      ]
    },
    {
      "id": "agents-preservation",
      "owner_skill": "management-skill",
      "name": "Global AGENTS preservation",
      "function": "Normal installation preserves user AGENTS; explicit AGENTS installation creates a persistent restorable backup.",
      "checks": [
        "management-units",
        "global-agents-parity"
      ]
    },
    {
      "id": "source-publication",
      "owner_skill": "management-skill",
      "name": "Source, installation and publication",
      "function": "Source owns maintained behavior; local installation and authorized remote publication remain separate; publication runs current release checks first.",
      "checks": [
        "management-units",
        "public-skill-set",
        "project-testing-units",
        "deployment-parity",
        "git-diff-check"
      ]
    },
    {
      "id": "portability",
      "owner_skill": "code-skill",
      "name": "Portable host execution",
      "function": "Host helpers use portable Python, native paths and noninteractive execution without forcing whole project builds.",
      "checks": [
        "code-units",
        "platform-check"
      ]
    },
    {
      "id": "optimization",
      "owner_skill": "optimization-skill",
      "name": "Measured simplification",
      "function": "Optimize requested or recurring work with measured evidence; measure improvements without triggering routine benchmarks.",
      "checks": [
        "optimization-units",
        "optimization-audit"
      ]
    },
    {
      "id": "resources",
      "owner_skill": "workflow-skill",
      "name": "Global resource coordination and Ending audit",
      "function": "Follow specific owner cleanup first, then audit recent completed tasks and release confirmed disposable Cache, UI, process and network resources; preserve active work and user review/reuse.",
      "checks": [
        "workflow-units",
        "project-memory-units",
        "management-units"
      ]
    },
    {
      "id": "concise-contracts",
      "owner_skill": "management-skill",
      "name": "Concise current instructions",
      "function": "Entries and references describe current responsibilities without repeated lifecycle ceremonies; behavioral tests replace obsolete workflow text checks.",
      "checks": [
        "workflow-validator",
        "management-units"
      ]
    }
  ],
  "retired_architectures": [
    {
      "id": "legacy-detached-verification",
      "name": "Ending verification and automatic repair tasks",
      "replacement": "ending-memory"
    },
    {
      "id": "legacy-benchmark-attestations",
      "name": "Old workflow benchmark and text attestation evidence as current release requirements",
      "replacement": "concise-contracts"
    }
  ]
}
